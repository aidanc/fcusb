; USB2Xchange WinUSB binding source.
; This INF is not installable until a matching signed catalog is generated.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = usb2xchange-winusb.cat
DriverVer   = 08/07/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Models,NTamd64

[Models.NTamd64]
%LoaderDeviceName%      = WinUSB_Install, USB\VID_03F3&PID_2002
%OperationalDeviceName% = WinUSB_Install, USB\VID_03F3&PID_2003

[WinUSB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUSB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[WinUSB_Install.HW]
AddReg = DeviceInterface_AddReg

[DeviceInterface_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{86A64B6A-BC77-49D2-B378-0F43E5DAA568}"

[Strings]
ManufacturerName     = "USB2Xchange Community Project"
LoaderDeviceName      = "Adaptec USB2Xchange Firmware Loader (WinUSB)"
OperationalDeviceName = "Adaptec USB2Xchange Adapter (WinUSB)"
